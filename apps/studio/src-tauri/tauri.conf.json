{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jana Studio",
  "version": "0.0.0",
  "identifier": "app.jana.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5191"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jana Studio",
        "width": 1440,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../desktop/src-tauri/icons/icon.png"
    ]
  }
}
