{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "appimage", "deb"],
    "category": "Education",
    "shortDescription": "Internal curriculum authoring and evaluation.",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "resources/studio-backend/": "studio-backend/",
      "resources/tool-worker/": "tool-worker/"
    },
    "windows": { "webviewInstallMode": { "type": "skip" } },
    "macOS": { "minimumSystemVersion": "13.0", "hardenedRuntime": true },
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "bubblewrap"] } }
  }
}
