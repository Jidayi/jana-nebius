{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jana",
  "version": "0.0.0",
  "identifier": "app.jana.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Jana",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "'self' http://127.0.0.1:* ws://127.0.0.1:*",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "media-src": "'self' blob:"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
