{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jana.dev/renderers/kinds/titration_sim",
  "$comment": "Params for titration_sim, owned by the vetted renderer (VSL-08, VSL-30). Strong acid and strong base at O level; pH readings at the declared volumes are computed by chem_acid_base (VER-21) and the client model is cross-checked against it (VSL-31). An optional `predict` names a predict, observe, explain scenario (VSL-47). Free-form drawing fields (svg, path, html, points_raw) are not allowed (VSL-01).",
  "title": "titration_sim params",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acid",
    "base",
    "acid_volume",
    "indicator"
  ],
  "properties": {
    "acid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formula",
        "concentration"
      ],
      "properties": {
        "formula": {
          "enum": [
            "HCl",
            "HNO3"
          ]
        },
        "concentration": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 2
        }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formula",
        "concentration"
      ],
      "properties": {
        "formula": {
          "enum": [
            "NaOH",
            "KOH"
          ]
        },
        "concentration": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 2
        }
      }
    },
    "acid_volume": {
      "type": "number",
      "minimum": 5,
      "maximum": 50
    },
    "indicator": {
      "enum": [
        "phenolphthalein",
        "methyl_orange"
      ]
    },
    "locked": {
      "type": "array",
      "items": {
        "enum": [
          "acid",
          "base",
          "acid_volume",
          "indicator"
        ]
      },
      "maxItems": 4,
      "uniqueItems": true
    },
    "predict": {
      "$comment": "A predict, observe, explain scenario of this kind (VSL-47, packages/renderers/src/sims/scenarios.json): the student predicts before the simulation runs; the scenario's starting values replace the request's own.",
      "enum": [
        "poe.chm.titration_double_strength_alkali.v1"
      ]
    }
  },
  "$defs": {
    "add": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element"
      ],
      "properties": {
        "element": {
          "enum": [
            "reading_note"
          ]
        },
        "of": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$",
          "maxLength": 64
        },
        "params": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    }
  }
}
