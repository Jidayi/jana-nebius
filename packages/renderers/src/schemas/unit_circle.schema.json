{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jana.dev/renderers/kinds/unit_circle",
  "$comment": "Params for unit_circle, owned by the vetted renderer (VSL-03). Ratio values are computed by math_evaluate in degrees (VER-15) during resolution; the angle traces to a known or a check. Free-form drawing fields (svg, path, html, points_raw) are not allowed (VSL-01).",
  "title": "unit_circle params",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "angle_deg"
  ],
  "properties": {
    "angle_deg": {
      "type": "number",
      "minimum": -360,
      "maximum": 720
    },
    "show": {
      "type": "array",
      "items": {
        "enum": [
          "sin",
          "cos",
          "tan",
          "quadrant_signs"
        ]
      },
      "maxItems": 4,
      "uniqueItems": true
    }
  },
  "$defs": {
    "add": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element"
      ],
      "properties": {
        "element": {
          "enum": [
            "reference_angle"
          ]
        },
        "of": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$",
          "maxLength": 64
        },
        "params": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    }
  }
}
