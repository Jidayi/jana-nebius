{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jana.dev/renderers/kinds/circuit_sim",
  "$comment": "Params for circuit_sim, owned by the vetted renderer (VSL-08, VSL-30). Starting values within the declared ranges; meter readings at the starting values are computed by phys_circuit (VER-16). An optional `predict` names a predict, observe, explain scenario (VSL-47). Free-form drawing fields (svg, path, html, points_raw) are not allowed (VSL-01).",
  "title": "circuit_sim params",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "emf",
    "resistors",
    "arrangement"
  ],
  "properties": {
    "emf": {
      "type": "number",
      "minimum": 1.5,
      "maximum": 24
    },
    "resistors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "resistance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[1-3]$"
          },
          "resistance": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "maxItems": 3,
      "minItems": 1
    },
    "arrangement": {
      "enum": [
        "series",
        "parallel"
      ]
    },
    "switch_closed": {
      "type": "boolean",
      "default": true
    },
    "locked": {
      "type": "array",
      "items": {
        "enum": [
          "emf",
          "arrangement",
          "R1",
          "R2",
          "R3",
          "switch"
        ]
      },
      "maxItems": 6,
      "uniqueItems": true
    },
    "predict": {
      "$comment": "A predict, observe, explain scenario of this kind (VSL-47, packages/renderers/src/sims/scenarios.json): the student predicts before the simulation runs; the scenario's starting values replace the request's own.",
      "enum": [
        "poe.phy.circuit_series_to_parallel.v1"
      ]
    }
  },
  "$defs": {
    "add": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element"
      ],
      "properties": {
        "element": {
          "enum": [
            "reading_note"
          ]
        },
        "of": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$",
          "maxLength": 64
        },
        "params": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    }
  }
}
