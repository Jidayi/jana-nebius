{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jana.dev/renderers/kinds/number_line",
  "$comment": "Params for number_line, owned by the vetted renderer (VSL-03). Bounds are claim numbers: they trace to the check that solved the inequality or to knowns (VSL-12). Free-form drawing fields (svg, path, html, points_raw) are not allowed (VSL-01).",
  "title": "number_line params",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intervals"
  ],
  "properties": {
    "variable": {
      "type": "string",
      "pattern": "^[a-z]$"
    },
    "intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,15}$"
          },
          "from": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 24,
                "pattern": "^-?[0-9]+(\\.[0-9]+)?(/[0-9]+)?$"
              },
              {
                "const": "-inf"
              }
            ]
          },
          "to": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 24,
                "pattern": "^-?[0-9]+(\\.[0-9]+)?(/[0-9]+)?$"
              },
              {
                "const": "inf"
              }
            ]
          },
          "from_closed": {
            "type": "boolean",
            "default": false
          },
          "to_closed": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "maxItems": 3,
      "minItems": 1
    },
    "combine": {
      "enum": [
        "union",
        "intersection"
      ]
    },
    "range": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2
    }
  },
  "$defs": {
    "add": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element"
      ],
      "properties": {
        "element": {
          "enum": [
            "test_point",
            "region_label"
          ]
        },
        "of": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$",
          "maxLength": 64
        },
        "params": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    }
  }
}
