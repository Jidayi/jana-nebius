{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jana.dev/renderers/kinds/statistics_chart",
  "$comment": "Params for statistics_chart, owned by the vetted renderer (VSL-03). Data come from the question (N1, known ids); class widths and frequency densities are layout, labelled only with the given figures. Free-form drawing fields (svg, path, html, points_raw) are not allowed (VSL-01).",
  "title": "statistics_chart params",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chart"
  ],
  "properties": {
    "chart": {
      "enum": [
        "bar",
        "pie",
        "histogram",
        "frequency_polygon",
        "cumulative_frequency",
        "box_plot"
      ]
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,15}$"
          },
          "label": {
            "type": "string",
            "maxLength": 24
          },
          "value": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^-?[0-9]+(\\.[0-9]+)?(/[0-9]+)?$"
          }
        }
      },
      "maxItems": 12
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lower",
          "upper",
          "frequency"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,15}$"
          },
          "lower": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^-?[0-9]+(\\.[0-9]+)?(/[0-9]+)?$"
          },
          "upper": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^-?[0-9]+(\\.[0-9]+)?(/[0-9]+)?$"
          },
          "frequency": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^-?[0-9]+(\\.[0-9]+)?(/[0-9]+)?$"
          }
        }
      },
      "maxItems": 12
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "q1",
        "median",
        "q3",
        "max"
      ],
      "properties": {
        "min": {
          "type": "string",
          "maxLength": 24,
          "pattern": "^-?[0-9]+(\\.[0-9]+)?(/[0-9]+)?$"
        },
        "q1": {
          "type": "string",
          "maxLength": 24,
          "pattern": "^-?[0-9]+(\\.[0-9]+)?(/[0-9]+)?$"
        },
        "median": {
          "type": "string",
          "maxLength": 24,
          "pattern": "^-?[0-9]+(\\.[0-9]+)?(/[0-9]+)?$"
        },
        "q3": {
          "type": "string",
          "maxLength": 24,
          "pattern": "^-?[0-9]+(\\.[0-9]+)?(/[0-9]+)?$"
        },
        "max": {
          "type": "string",
          "maxLength": 24,
          "pattern": "^-?[0-9]+(\\.[0-9]+)?(/[0-9]+)?$"
        }
      }
    },
    "axis_labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "x": {
          "type": "string",
          "maxLength": 24
        },
        "y": {
          "type": "string",
          "maxLength": 24
        }
      }
    }
  },
  "$defs": {
    "add": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element"
      ],
      "properties": {
        "element": {
          "enum": [
            "mean_line"
          ]
        },
        "of": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$",
          "maxLength": 64
        },
        "params": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    }
  }
}
