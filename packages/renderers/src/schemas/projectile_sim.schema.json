{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jana.dev/renderers/kinds/projectile_sim",
  "$comment": "Params for projectile_sim, owned by the vetted renderer (VSL-08, VSL-30). Starting values within the declared ranges; readouts at the starting values are computed by phys_projectile (VER-17) and the client model is cross-checked against it (VSL-31). Free-form drawing fields (svg, path, html, points_raw) are not allowed (VSL-01).",
  "title": "projectile_sim params",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "speed"
  ],
  "properties": {
    "mode": {
      "enum": [
        "horizontal",
        "vertical"
      ]
    },
    "speed": {
      "type": "number",
      "minimum": 1,
      "maximum": 40
    },
    "height": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "locked": {
      "type": "array",
      "items": {
        "enum": [
          "mode",
          "speed",
          "height"
        ]
      },
      "maxItems": 3,
      "uniqueItems": true
    }
  },
  "$defs": {
    "add": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element"
      ],
      "properties": {
        "element": {
          "enum": [
            "trace_point"
          ]
        },
        "of": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$",
          "maxLength": 64
        },
        "params": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    }
  }
}
