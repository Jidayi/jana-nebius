{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jana.dev/renderers/kinds/transformation_grid",
  "$comment": "Params for transformation_grid, owned by the vetted renderer (VSL-04). Image coordinates are computed by geom_figure (VER-15). Free-form drawing fields (svg, path, html, points_raw) are not allowed (VSL-01).",
  "title": "transformation_grid params",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object",
    "transformation"
  ],
  "properties": {
    "object": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "x",
          "y"
        ],
        "properties": {
          "label": {
            "type": "string",
            "pattern": "^[A-Z][a-z0-9']{0,2}$"
          },
          "x": {
            "type": "integer",
            "minimum": -10,
            "maximum": 10
          },
          "y": {
            "type": "integer",
            "minimum": -10,
            "maximum": 10
          }
        }
      },
      "maxItems": 6,
      "minItems": 3
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "translation",
            "reflection",
            "rotation",
            "enlargement"
          ]
        },
        "vector": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -10,
            "maximum": 10
          },
          "maxItems": 2,
          "minItems": 2
        },
        "line": {
          "enum": [
            "x = 0",
            "y = 0",
            "y = x",
            "y = -x",
            "x = 1",
            "x = -1",
            "y = 1",
            "y = -1",
            "x = 2",
            "y = 2"
          ]
        },
        "centre": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -10,
            "maximum": 10
          },
          "maxItems": 2,
          "minItems": 2
        },
        "angle": {
          "enum": [
            90,
            180,
            270
          ]
        },
        "direction": {
          "enum": [
            "clockwise",
            "anticlockwise"
          ]
        },
        "scale": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 24,
              "pattern": "^-?[0-9]+(\\.[0-9]+)?(/[0-9]+)?$"
            },
            {
              "type": "number"
            }
          ]
        }
      }
    },
    "grid": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -12,
        "maximum": 12
      },
      "maxItems": 2,
      "minItems": 2
    }
  },
  "$defs": {
    "add": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element"
      ],
      "properties": {
        "element": {
          "enum": [
            "mapping_lines"
          ]
        },
        "of": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$",
          "maxLength": 64
        },
        "params": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    }
  }
}
