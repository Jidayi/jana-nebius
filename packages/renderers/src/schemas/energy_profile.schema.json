{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jana.dev/renderers/kinds/energy_profile",
  "$comment": "Params for energy_profile, owned by the vetted renderer (VSL-03). Energies are givens (N1, known ids). Free-form drawing fields (svg, path, html, points_raw) are not allowed (VSL-01).",
  "title": "energy_profile params",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reaction"
  ],
  "properties": {
    "reaction": {
      "enum": [
        "exothermic",
        "endothermic"
      ]
    },
    "reactants": {
      "type": "string",
      "maxLength": 24
    },
    "products": {
      "type": "string",
      "maxLength": 24
    },
    "activation_energy": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?( ?[^\\s].{0,30})?$"
    },
    "enthalpy_change": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?( ?[^\\s].{0,30})?$"
    },
    "catalysed": {
      "type": "boolean",
      "default": false
    }
  },
  "$defs": {
    "add": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element"
      ],
      "properties": {
        "element": {
          "enum": [
            "catalysed_path"
          ]
        },
        "of": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$",
          "maxLength": 64
        },
        "params": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    }
  }
}
