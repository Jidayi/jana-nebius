                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "passed",
              "total"
            ]
          },
          "raw_latex_spoken": {
            "type": "integer",
            "minimum": 0
          },
          "spoken_number_mismatches": {
            "type": "integer",
            "minimum": 0
          },
          "turn_latency": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "p50_s": {
                "type": "number",
                "minimum": 0
              },
              "p90_s": {
                "type": "number",
                "minimum": 0
              },
              "n": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "p50_s",
              "p90_s",
              "n"
            ]
          },
          "read_aloud_latency": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "p50_s": {
                "type": "number",
                "minimum": 0
              },
              "p90_s": {
                "type": "number",
                "minimum": 0
              },
              "n": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "p50_s",
              "p90_s",
              "n"
            ]
          },
          "intelligibility": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "minProperties": 1
          },
          "device_lab_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "candidate",
          "speech_pack",
          "sets",
          "consented_adult_speech_only",
          "accents",
          "languages",
          "wer_subject_vocabulary",
          "false_cutoffs",
          "raw_latex_spoken",
          "spoken_number_mismatches",
          "turn_latency",
          "read_aloud_latency",
          "intelligibility",
          "device_lab_ref"
        ],
        "description": "VOC-21 before voice_launch: the voice gates on frozen, hash-locked sets of licensed or consented adult speech (EVL-18, EVL-24), per language: word error rate on subject vocabulary, false cut-offs (VOC-05), raw LaTeX and spoken-number mismatches (VOC-08, VOC-20), latency (VOC-13, VOC-18) and listener intelligibility per offered voice, with the device-lab run behind them."
      }
