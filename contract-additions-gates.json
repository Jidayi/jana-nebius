    {
      "target": "ops/governance-records.schema.json",
      "pointer": "/$defs/voice_gates",
      "requirements": [
        "VOC-21",
        "EVL-18",
        "EVL-24"
      ],
      "why": "VOC-21 gates voice_launch on measured voice gates; no record format carries them.",
      "value": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "speech_pack": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pack_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "pack_id",
              "version",
              "sha256"
            ]
          },
          "sets": {
            "type": "object",
