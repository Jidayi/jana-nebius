              "type": "object",
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "lock_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "version",
                "lock_sha256"
              ]
            },
            "minProperties": 1
          },
          "consented_adult_speech_only": {
            "const": true
          },
