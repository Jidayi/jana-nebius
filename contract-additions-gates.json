{
  "proposal": "Gate evidence the specification implies (D72), for the release gates of the decisions register: the DPIA record and the signed DPIA list (PRV-08), counsel's two passes (D13), the paid-launch payment and signed installer records, the voice gates (VOC-21), the tuned-model evidence (EVL-27), the S4 client journey row, the teacher review (EVL-21), the claims register (PRD-09), usability results and reference-laptop journey runs (JRN-02), the S2 pilot exit metrics (PRD-17) and the gate evidence that bundles them. Each entry is a JSON Pointer into a contract under docs/specification/contracts and the value to add there; the values reuse the existing governance-records definitions. Until the specification adopts them, scripts/jana_tools/m23/records.py validates these kinds against this file (the local copy), and the code reads the adopted contract as soon as it has the definition.",
  "additions": [
    {
      "target": "ops/governance-records.schema.json",
      "pointer": "/$defs/dpia",
      "requirements": [
        "PRV-08"
      ],
      "why": "PRV-08 requires a DPIA per online feature, signed by the Safety lead, before the feature is enabled in a release; nothing records one, so no gate can check it.",
      "value": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DPIA-[A-Z0-9][A-Z0-9-]{1,40}$"
          },
          "gate": {
            "enum": [
              "pilot_start",
              "cloud_tier",
              "web_launch",
              "s4_launch",
              "s5_launch"
            ]
          },
          "features": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "telemetry",
                "crash_reports",
                "downloads",
                "update_checks",
                "research_data",
                "support_bundles",
                "cloud_tier",
                "web_client",
                "cloud_backup",
                "multi_device",
                "parent_remote_view",
                "relay",
                "cloud_voice",
                "model_training_research"
              ]
            }
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "assessment_ref": {
            "type": "string",
            "minLength": 1
          },
          "assessment_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "completed_at": {
            "type": "string",
            "format": "date"
          },
          "signed_at": {
            "type": "string",
            "format": "date"
          },
          "signed_by": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "enum": [
                  "safety_lead"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "role",
              "reference"
            ]
          },
          "residual_risk_accepted": {
            "const": true
          },
          "review_due": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "id",
          "gate",
          "features",
          "country",
          "assessment_ref",
          "assessment_sha256",
          "completed_at",
          "signed_at",
          "signed_by",
          "residual_risk_accepted"
        ],
        "description": "PRV-08: one DPIA, or a section of one with its own identifier, completed and signed by the Safety lead for the features of TABLE PRV-08a it covers. The assessment itself is a document the record names and hashes; the record holds references only, never student data."
      }
    },
    {
      "target": "ops/governance-records.schema.json",
      "pointer": "/$defs/counsel_pass",
      "requirements": [
        "PRV-07",
        "D13"
      ],
      "why": "D13 sets two counsel passes; the counsel record cannot say which pass it is, so cloud_tier cannot tell pass 2 (cross-border transfer) from pass 1.",
      "value": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pass": {
            "enum": [
              1,
              2
            ]
          },
          "gate": {
            "enum": [
              "pilot_start",
              "cloud_tier"
            ]
          },
          "counsel": {
            "$ref": "#/$defs/counsel"
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "processing_region": {
                  "type": "string",
                  "minLength": 1
                },
                "contract_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "retention_days": {
                  "type": "integer",
                  "minimum": 0
                },
                "used_for_training": {
                  "const": false
                }
              },
              "required": [
                "provider_ref",
                "processing_region",
                "contract_ref",
                "retention_days",
                "used_for_training"
              ]
            }
          }
        },
        "required": [
          "pass",
          "gate",
          "counsel"
        ],
        "description": "D13 (decided in D100): counsel reviews in two passes, the pilot without the cloud tier first, then the cloud tier with cross-border transfer (PRV-07a). Pass 2 names each assessed provider and region (PRV-25)."
      }
    },
