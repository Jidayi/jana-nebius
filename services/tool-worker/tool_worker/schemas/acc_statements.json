          "asset": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "debit": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "^\\s*[-(]?\\s*([$£€₦¥]|[A-Z]{3}\\s*)?\\s*(\\d{1,3}(,\\d{3})+|\\d+)(\\.\\d+)?\\s*\\)?\\s*$",
