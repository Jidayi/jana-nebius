          "role": {
            "enum": [
              "revenue",
              "sales_returns",
              "purchases",
              "purchases_returns",
              "carriage_inwards",
              "opening_inventory",
              "expense",
              "other_income",
              "non_current_asset",
              "accumulated_depreciation",
              "trade_receivables",
              "allowance_for_irrecoverable_debts",
              "other_receivables",
              "bank",
              "cash",
              "trade_payables",
              "other_payables",
              "bank_overdraft",
              "non_current_liability",
              "capital",
              "drawings"
