{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trial_balance"
  ],
  "properties": {
    "trial_balance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "account",
          "role"
        ],
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "role": {
            "enum": [
              "revenue",
              "sales_returns",
              "purchases",
              "purchases_returns",
              "carriage_inwards",
              "opening_inventory",
              "expense",
              "other_income",
              "non_current_asset",
              "accumulated_depreciation",
              "trade_receivables",
              "allowance_for_irrecoverable_debts",
              "other_receivables",
              "bank",
              "cash",
              "trade_payables",
              "other_payables",
              "bank_overdraft",
              "non_current_liability",
              "capital",
              "drawings"
            ]
          },
          "asset": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "debit": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "^\\s*[-(]?\\s*([$£€₦¥]|[A-Z]{3}\\s*)?\\s*(\\d{1,3}(,\\d{3})+|\\d+)(\\.\\d+)?\\s*\\)?\\s*$",
            "maxLength": 30
          },
          "credit": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "^\\s*[-(]?\\s*([$£€₦¥]|[A-Z]{3}\\s*)?\\s*(\\d{1,3}(,\\d{3})+|\\d+)(\\.\\d+)?\\s*\\)?\\s*$",
            "maxLength": 30
          }
        }
      }
    },
    "adjustments": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "accrued_expense",
              "prepaid_expense",
              "accrued_income",
              "income_in_advance",
              "depreciation",
              "irrecoverable_debt",
              "allowance",
              "closing_inventory",
              "goods_for_own_use"
            ]
          },
          "account": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "amount": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "^\\s*[-(]?\\s*([$£€₦¥]|[A-Z]{3}\\s*)?\\s*(\\d{1,3}(,\\d{3})+|\\d+)(\\.\\d+)?\\s*\\)?\\s*$",
            "maxLength": 30
          },
          "method": {
            "enum": [
              "straight_line",
              "reducing_balance"
            ]
          },
          "rate_percent": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "^\\s*\\d+(\\.\\d+)?\\s*%?\\s*$",
            "maxLength": 12
          },
          "percent": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "^\\s*\\d+(\\.\\d+)?\\s*%?\\s*$",
            "maxLength": 12
          },
          "check_id": {
            "type": "string",
            "pattern": "^chk_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        }
      }
    },
    "period": {
      "type": "string",
      "maxLength": 60
    },
    "layout": {
      "enum": [
        "capital_and_liabilities",
        "net_assets"
      ]
    },
    "terms": {
      "type": "object",
      "maxProperties": 60,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_:]{1,60}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "student": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "lines"
      ],
      "properties": {
        "statement": {
          "enum": [
            "income_statement",
            "financial_position"
          ]
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "amount"
            ],
            "properties": {
              "line": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_:]{1,80}$"
              },
              "label": {
                "type": "string",
                "maxLength": 80
              },
              "amount": {
                "type": [
                  "integer",
                  "string"
                ],
                "pattern": "^\\s*[-(]?\\s*([$£€₦¥]|[A-Z]{3}\\s*)?\\s*(\\d{1,3}(,\\d{3})+|\\d+)(\\.\\d+)?\\s*\\)?\\s*$",
                "maxLength": 30
              }
            }
          }
        }
      }
    },
    "dp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    }
  }
}
