{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "not": {
          "required": [
            "form"
          ]
        }
      },
      "then": {
        "required": [
          "trial_balance"
        ]
      }
    },
    {
      "if": {
        "required": [
          "form"
        ],
        "properties": {
          "form": {
            "const": "sole_trader"
          }
        }
      },
      "then": {
        "required": [
          "trial_balance"
        ]
      }
    },
    {
      "if": {
        "required": [
          "form"
        ],
        "properties": {
          "form": {
            "const": "partnership"
          }
        }
      },
      "then": {
        "required": [
          "partnership"
        ]
      }
    },
    {
      "if": {
        "required": [
          "form"
        ],
        "properties": {
          "form": {
            "const": "limited_company"
          }
        }
      },
      "then": {
        "required": [
          "company"
        ]
      }
    },
    {
      "if": {
        "required": [
          "form"
        ],
        "properties": {
          "form": {
            "const": "manufacturing"
          }
        }
      },
      "then": {
        "required": [
          "manufacturing"
        ]
      }
    },
    {
      "if": {
        "required": [
          "form"
        ],
        "properties": {
          "form": {
            "const": "incomplete_records"
          }
        }
      },
      "then": {
        "required": [
          "incomplete_records"
        ]
      }
    }
