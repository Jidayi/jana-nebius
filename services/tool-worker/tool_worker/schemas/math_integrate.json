{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "method"
        ]
      },
      "then": {
        "required": [
          "strips",
          "lower",
          "upper"
        ]
      }
    },
    {
      "if": {
        "required": [
          "volume"
        ]
      },
      "then": {
        "required": [
          "lower",
          "upper"
        ]
      }
    }
  ],
  "required": [
    "expression"
  ],
  "properties": {
    "expression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "variable": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]{0,15}(_[A-Za-z0-9]{1,8})?$"
    },
    "lower": {
      "type": [
        "number",
        "string"
      ],
      "pattern": "^([0-9+\\-*/^(). ]|pi|e|sqrt|ln|log|exp)+$",
      "maxLength": 40
    },
    "upper": {
      "type": [
        "number",
        "string"
      ],
      "pattern": "^([0-9+\\-*/^(). ]|pi|e|sqrt|ln|log|exp)+$",
      "maxLength": 40
    },
    "area": {
      "type": "boolean"
    },
    "student": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "constant": {
      "type": "string",
      "pattern": "^[A-Za-z]$"
    },
    "volume": {
      "enum": [
        "x_axis",
        "y_axis"
      ]
    },
    "method": {
      "enum": [
        "trapezium"
      ]
    },
    "strips": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "sf": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "substitution": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "parts_u": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "variables": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9]{0,15}(_[A-Za-z0-9]{1,8})?$"
      }
    },
    "assumptions": {
      "type": "object",
      "maxProperties": 20,
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "positive",
            "nonzero",
            "integer",
            "nonnegative"
          ]
        }
      }
    },
    "level": {
      "enum": [
        "O",
        "A"
      ]
    },
    "log_base": {
      "enum": [
        2,
        10
      ]
    },
    "decimal_comma": {
      "type": "boolean"
    }
  }
}
