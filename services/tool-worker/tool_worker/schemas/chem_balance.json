{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "equation"
  ],
  "properties": {
    "equation": {
      "type": "string",
      "minLength": 3,
      "maxLength": 400
    },
    "coefficients": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": [
          "integer",
          "string"
        ],
        "minimum": 1,
        "pattern": "^[0-9]+(/[0-9]+)?$",
        "maxLength": 12
      }
    }
  }
}
