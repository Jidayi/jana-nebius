{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task": {
      "enum": [
        "calorimetry",
        "bond_energies"
      ]
    },
    "mass": {
      "type": [
        "number",
        "string"
      ],
      "minLength": 1,
      "maxLength": 40
    },
    "specific_heat": {
      "type": [
        "number",
        "string"
      ],
      "minLength": 1,
      "maxLength": 40
    },
    "specific_heat_source": {
      "enum": [
        "question",
        "item",
        "pack"
      ]
    },
    "temperature_change": {
      "type": [
        "number",
        "string"
      ],
      "minLength": 1,
      "maxLength": 40
    },
    "initial_temperature": {
      "type": [
        "number",
        "string"
      ],
      "minLength": 1,
      "maxLength": 40
    },
    "final_temperature": {
      "type": [
        "number",
        "string"
      ],
      "minLength": 1,
      "maxLength": 40
    },
    "amount": {
      "type": [
        "number",
        "string"
      ],
      "minLength": 1,
      "maxLength": 40
    },
    "fuel_mass": {
      "type": [
        "number",
        "string"
      ],
      "minLength": 1,
      "maxLength": 40
    },
    "formula": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "broken": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bond",
          "energy"
        ],
        "properties": {
          "bond": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "energy": {
            "type": [
              "number",
              "string"
            ],
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    },
    "formed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bond",
          "energy"
        ],
        "properties": {
          "bond": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "energy": {
            "type": [
              "number",
              "string"
            ],
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    },
    "constants": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "source"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_()]{0,31}$"
          },
          "value": {
            "type": [
              "number",
              "string"
            ],
            "pattern": "^[+-]?(\\d+(\\.\\d*)?|\\.\\d+)([eE][+-]?\\d+)?$",
            "maxLength": 40
          },
          "unit": {
            "type": "string",
            "maxLength": 40
          },
          "source": {
            "enum": [
              "question",
              "item",
              "pack",
              "default"
            ]
          }
        }
      }
    },
    "sf": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  }
}
