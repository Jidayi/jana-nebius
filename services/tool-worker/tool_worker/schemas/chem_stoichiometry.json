{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "steps"
  ],
  "properties": {
    "equation": {
      "type": "string",
      "minLength": 3,
      "maxLength": 400
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "op"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
          },
          "op": {
            "enum": [
              "amount_from_mass",
              "mass_from_amount",
              "amount_from_concentration",
              "concentration_from_amount",
              "amount_from_gas_volume",
              "gas_volume_from_amount",
              "mole_ratio",
              "limiting_reagent",
              "percentage_yield",
              "purity",
              "atom_economy",
              "electrolysis"
            ]
          },
          "species": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "product": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "mass": {
            "type": [
              "number",
              "string"
            ],
            "minLength": 1,
            "maxLength": 40
          },
          "amount": {
            "type": [
              "number",
              "string"
            ],
            "minLength": 1,
            "maxLength": 40
          },
          "volume": {
            "type": [
              "number",
              "string"
            ],
            "minLength": 1,
            "maxLength": 40
          },
          "concentration": {
            "type": [
              "number",
              "string"
            ],
            "minLength": 1,
            "maxLength": 40
          },
          "actual": {
            "type": [
              "number",
              "string"
            ],
            "minLength": 1,
            "maxLength": 40
          },
          "theoretical": {
            "type": [
              "number",
              "string"
            ],
            "minLength": 1,
            "maxLength": 40
          },
          "pure_mass": {
            "type": [
              "number",
              "string"
            ],
            "minLength": 1,
            "maxLength": 40
          },
          "sample_mass": {
            "type": [
              "number",
              "string"
            ],
            "minLength": 1,
            "maxLength": 40
          },
          "current": {
            "type": [
              "number",
              "string"
            ],
            "minLength": 1,
            "maxLength": 40
          },
          "time": {
            "type": [
              "number",
              "string"
            ],
            "minLength": 1,
            "maxLength": 40
          },
          "electrons": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "amounts": {
            "type": "object",
            "minProperties": 2,
            "maxProperties": 6,
            "additionalProperties": {
              "type": [
                "number",
                "string"
              ],
              "minLength": 1,
              "maxLength": 40
            }
          }
        }
      }
    },
    "cites": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "check"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^chk_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "check": {
            "enum": [
              "chem_balance",
              "chem_molar_mass"
            ]
          },
          "formula": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "molar_mass": {
            "type": [
              "number",
              "string"
            ],
            "minLength": 1,
            "maxLength": 40
          },
          "coefficients": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": {
              "type": [
                "integer",
                "string"
              ],
              "minimum": 1,
              "pattern": "^[0-9]+(/[0-9]+)?$",
              "maxLength": 12
            }
          }
        }
      }
    },
    "constants": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "source"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_()]{0,31}$"
          },
          "value": {
            "type": [
              "number",
              "string"
            ],
            "pattern": "^[+-]?(\\d+(\\.\\d*)?|\\.\\d+)([eE][+-]?\\d+)?$",
            "maxLength": 40
          },
          "unit": {
            "type": "string",
            "maxLength": 40
          },
          "source": {
            "enum": [
              "question",
              "item",
              "pack",
              "default"
            ]
          }
        }
      }
    },
    "sf": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  }
}
