{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prev",
    "next"
  ],
  "properties": {
    "prev": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "next": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "givens": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": [
          "number",
          "string"
        ]
      }
    },
    "variables": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9]{0,15}(_[A-Za-z0-9]{1,8})?$"
      }
    },
    "assumptions": {
      "type": "object",
      "maxProperties": 20,
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "positive",
            "nonzero",
            "integer",
            "nonnegative"
          ]
        }
      }
    },
    "level": {
      "enum": [
        "O",
        "A"
      ]
    },
    "log_base": {
      "enum": [
        2,
        10
      ]
    },
    "decimal_comma": {
      "type": "boolean"
    }
  }
}
