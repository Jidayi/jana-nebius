{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "components"
  ],
  "properties": {
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]{0,5}$"
          },
          "kind": {
            "enum": [
              "resistor",
              "lamp",
              "cell",
              "battery",
              "ammeter",
              "voltmeter",
              "switch"
            ]
          },
          "resistance": {
            "$ref": "#/$defs/number"
          },
          "emf": {
            "$ref": "#/$defs/number"
          },
          "internal_resistance": {
            "$ref": "#/$defs/number"
          },
          "state": {
            "enum": [
              "open",
              "closed"
            ]
          }
        }
      }
    },
    "network": {
      "$ref": "#/$defs/group"
    },
    "connections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "$ref": "#/$defs/terminal"
          },
          "to": {
            "$ref": "#/$defs/terminal"
          }
        }
      }
    }
  },
  "$defs": {
    "number": {
      "type": [
        "number",
        "string"
      ],
      "pattern": "^[+-]?(\\d+(\\.\\d*)?|\\.\\d+)([eE][+-]?\\d+)?$",
      "maxLength": 40
    },
    "terminal": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{0,5}\\.(a|b|pos|neg)$"
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "series": {
          "$ref": "#/$defs/members"
        },
        "parallel": {
          "$ref": "#/$defs/members"
        }
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]{0,5}$"
          },
          {
            "$ref": "#/$defs/group"
          }
        ]
      }
    }
  }
}
