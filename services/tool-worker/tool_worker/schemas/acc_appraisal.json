{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "initial_investment",
    "cash_flows"
  ],
  "properties": {
    "initial_investment": {
      "type": [
        "integer",
        "string"
      ],
      "pattern": "^\\s*[-(]?\\s*([$£€₦¥]|[A-Z]{3}\\s*)?\\s*(\\d{1,3}(,\\d{3})+|\\d+)(\\.\\d+)?\\s*\\)?\\s*$",
      "maxLength": 30
    },
    "cash_flows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": [
          "integer",
          "string"
        ],
        "pattern": "^\\s*[-(]?\\s*([$£€₦¥]|[A-Z]{3}\\s*)?\\s*(\\d{1,3}(,\\d{3})+|\\d+)(\\.\\d+)?\\s*\\)?\\s*$",
        "maxLength": 30
      }
    },
    "residual_value": {
      "type": [
        "integer",
        "string"
      ],
      "pattern": "^\\s*[-(]?\\s*([$£€₦¥]|[A-Z]{3}\\s*)?\\s*(\\d{1,3}(,\\d{3})+|\\d+)(\\.\\d+)?\\s*\\)?\\s*$",
      "maxLength": 30
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "payback",
          "arr",
          "npv",
          "irr"
        ]
      }
    },
    "payback_months": {
      "enum": [
        "round_up",
        "nearest"
      ]
    },
    "arr_basis": {
      "enum": [
        "average_investment",
        "initial_investment"
      ]
    },
    "discount_rate_percent": {
      "type": [
        "integer",
        "string"
      ],
      "pattern": "^\\s*\\d+(\\.\\d+)?\\s*$",
      "maxLength": 12
    },
    "discount_factors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": [
          "integer",
          "string"
        ],
        "pattern": "^\\s*\\d+(\\.\\d+)?\\s*$",
        "maxLength": 12
      }
    },
    "irr_rates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": [
          "integer",
          "string"
        ],
        "pattern": "^\\s*\\d+(\\.\\d+)?\\s*$",
        "maxLength": 12
      }
    },
    "irr_factors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 50,
        "items": {
          "type": [
            "integer",
            "string"
          ],
          "pattern": "^\\s*\\d+(\\.\\d+)?\\s*$",
          "maxLength": 12
        }
      }
    },
    "dp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    }
  }
}
