       "finalise",
       "delegate"
      ]
     },
     "verdict": {
      "enum": [
       "continue",
       "loop",
       "break",
       "return"
      ]
     },
     "iteration": {
      "type": "integer",
      "minimum": 0
     },
     "start_offset_ms": {
      "type": "integer",
      "minimum": 0
     },
     "duration_ms": {
      "type": "integer",
      "minimum": 0
     }
    }
   }
  },
  "delegations": {
   "type": "array",
   "maxItems": 16,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "role",
     "outcome",
     "duration_ms"
    ],
    "properties": {
     "role": {
      "$ref": "#/$defs/role"
     },
     "outcome": {
      "enum": [
       "completed",
       "partial",
       "error"
      ]
     },
     "stop_reason": {
      "enum": [
       "done",
       "max_steps",
       "tool_failures",
       "empty_handoff",
       "schema_invalid",
       "provider_error",
       "cancelled",
       "timeout",
       "blocked"
      ]
     },
     "duration_ms": {
      "type": "integer",
      "minimum": 0
     }
    }
   }
  },
  "budget": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "tokens_budget": {
     "type": "integer",
     "minimum": 0
    },
    "tokens_used": {
     "type": "integer",
     "minimum": 0
    },
    "usd_budget": {
     "type": "number",
     "minimum": 0
    },
    "usd_used": {
     "type": "number",
     "minimum": 0
    },
    "reminders_sent": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "compaction": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "happened"
   ],
   "properties": {
    "happened": {
     "type": "boolean"
    },
    "before_tokens": {
     "type": "integer",
     "minimum": 0
    },
    "after_tokens": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "connectivity": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "state_at_start",
    "features_used"
   ],
   "properties": {
    "state_at_start": {
     "enum": [
      "off",
      "offline",
      "limited",
      "metered",
      "online"
     ]
    },
    "features_used": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "enum": [
       "cloud_tier",
       "downloads",
       "update_checks",
       "cloud_backup",
       "multi_device",
       "parent_remote_view",
       "cloud_voice",
       "study_materials",
       "telemetry",
       "crash_reports"
      ]
     }
    },
    "egress_bytes": {
     "type": "object",
     "propertyNames": {
      "enum": [
       "cloud_tier",
       "downloads",
       "update_checks",
       "cloud_backup",
       "multi_device",
       "parent_remote_view",
       "cloud_voice",
       "study_materials",
       "telemetry",
       "crash_reports"
      ]
     },
     "additionalProperties": {
      "type": "integer",
      "minimum": 0
     }
    }
   }
  },
  "capture": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "mode",
    "redaction_policy_version"
   ],
   "properties": {
    "mode": {
     "enum": [
      "hashes",
      "full"
     ]
    },
    "expires_at": {
     "type": "string",
     "format": "date-time"
    },
    "redaction_policy_version": {
     "type": "string",
     "maxLength": 16
    }
   }
  },
  "policy_decisions": {
   "type": "array",
   "maxItems": 64,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "policy",
     "inputs",
     "output"
    ],
    "properties": {
     "policy": {
      "enum": [
       "difficulty_targeting",
       "worked_example_fading",
       "hint_start_rung",
       "gaming_detection",
       "unprompted_help",
       "self_explanation",
       "representation",
       "prerequisite_detour",
       "interleaving",
       "exam_proximity",
       "stuck_cap",
       "support_level"
      ]
     },
     "inputs": {
      "type": "object"
     },
     "output": {
      "type": "object"
     }
    }
   }
  },
  "perception": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "source",
    "outcome",
    "reader",
    "quality_checks",
    "region_confidences",
    "durations_ms",
    "confirm_method",
    "confirm_edit_distance"
   ],
   "properties": {
    "source": {
     "enum": [
      "typed",
      "pasted_text",
      "photo_file",
      "photo_paste",
      "photo_drop",
      "webcam",
      "device_camera",
      "pdf",
      "handwriting_photo",
      "ink",
      "voice"
     ]
    },
    "outcome": {
     "enum": [
      "drafting",
      "preprocessing",
      "quality_failed",
      "reading",
      "awaiting_confirmation",
      "confirmed",
      "unreadable",
      "refused",
      "cancelled"
     ]
    },
    "reader": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "path",
      "model_id",
      "hardware_class",
      "duration_ms",
      "model_version"
     ],
     "properties": {
      "path": {
       "enum": [
        "none",
        "vision_model",
        "ocr_pipeline",
        "formula_recogniser",
        "cloud_vision",
        "school_server",
        "pdf_text_layer",
        "speech_to_text"
       ]
      },
      "model_id": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 128
        },
        {
         "type": "null"
        }
       ]
      },
      "model_version": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 64
        },
        {
         "type": "null"
        }
       ]
      },
      "hardware_class": {
       "enum": [
        "content_only",
        "low",
        "mid",
        "high",
        "server"
       ]
      },
      "duration_ms": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "quality_checks": {
     "type": "array",
     "maxItems": 10,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "check",
       "value",
       "outcome"
      ],
      "properties": {
       "check": {
        "enum": [
         "blur",
         "glare",
         "darkness",
         "skew",
         "small_text",
         "resolution",
         "no_text"
        ]
       },
       "value": {
        "type": "number"
       },
       "outcome": {
        "enum": [
         "pass",
         "advisory",
         "blocking"
        ]
       }
      }
     }
    },
    "region_confidences": {
     "type": "array",
     "maxItems": 200,
     "items": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     }
    },
    "durations_ms": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "preprocess",
      "read",
      "total"
     ],
     "properties": {
      "preprocess": {
       "type": "integer",
       "minimum": 0
      },
      "read": {
       "type": "integer",
       "minimum": 0
      },
      "total": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "confirm_method": {
     "enum": [
      "pending",
      "sent",
      "accepted",
      "edited",
      "retyped"
     ]
    },
    "confirm_edit_distance": {
     "type": "integer",
     "minimum": 0
    }
   }
  }
 },
 "$defs": {
  "ulid": {
   "type": "string",
   "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
  },
  "role": {
   "enum": [
    "coach",
    "diagnoser",
    "solver",
    "checker",
    "reflector",
    "rule_matcher",
    "input_guard",
    "vision",
    "title",
    "compaction",
    "judge",
    "item_drafter"
   ]
  },
  "effort": {
   "enum": [
    "none",
    "low",
    "medium",
    "high"
   ]
  }
 }
}
