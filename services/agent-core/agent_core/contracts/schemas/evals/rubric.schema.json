   "const": true
  },
  "owner_role": {
   "type": "string",
   "maxLength": 60
  },
  "applies_to": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "enum": [
     "guided_dialogue",
     "solution",
     "check_my_working",
     "lesson",
     "practice_feedback",
     "exam_review",
     "simulated_student_run",
     "safety_response",
     "parent_digest",
     "conceptual_answer"
    ]
   }
  },
  "locales": {
   "type": "array",
   "uniqueItems": true,
   "default": [
    "en"
   ],
   "items": {
    "type": "string",
    "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
   }
  },
  "subjects": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "enum": [
     "mathematics",
     "physics",
     "chemistry",
     "biology",
     "accounting"
    ]
   }
  },
  "judging": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "judges",
    "independent",
