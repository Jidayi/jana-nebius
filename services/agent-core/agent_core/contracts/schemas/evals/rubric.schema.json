       "solver_plan",
       "learner_block",
       "content_pack_passages"
      ]
     }
    },
    "excluded_from_judge_pool": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "criteria": {
   "type": "array",
   "minItems": 1,
   "maxItems": 30,
   "items": {
    "type": "object",
