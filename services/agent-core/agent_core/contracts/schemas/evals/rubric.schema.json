    "evidence_scope"
   ],
   "properties": {
    "judges": {
     "type": "array",
     "minItems": 2,
     "maxItems": 3,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "kind",
       "ref"
      ],
      "properties": {
       "kind": {
        "enum": [
