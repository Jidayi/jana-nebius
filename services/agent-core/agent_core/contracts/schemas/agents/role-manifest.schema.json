{
 "$comment": "GENERATED from docs/specification/contracts/agents/role-manifest.schema.json sha256 a56deff9cf5edb63c9dc49e8f9f993030ee02d3b891706b95a0a6b7caff34093; do not edit",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://jana.dev/contracts/agents/role-manifest",
 "title": "Role manifest front matter",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "version",
  "name",
  "kind",
  "audience",
  "model_role",
  "toolsets",
  "tools",
  "output_mode",
  "output_schema",
  "soul",
  "prompt_mode",
  "permissions",
  "limits",
  "owner",
  "last_reviewed_by",
  "last_reviewed_at",
  "status",
  "stage"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z_]{1,30}$"
  },
  "version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+$"
  },
  "name": {
   "type": "string",
   "minLength": 1,
   "maxLength": 40
  },
  "kind": {
   "enum": [
    "specialist",
    "auxiliary"
   ]
  },
  "audience": {
   "enum": [
    "student",
    "team"
   ]
  },
  "model_role": {
   "type": "string",
   "pattern": "^[a-z][a-z_]{1,30}$"
  },
  "toolsets": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "enum": [
     "compute",
     "knowledge",
     "ui",
     "plan",
     "memory",
     "meta",
     "external"
    ]
   }
  },
  "tools": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9_]{1,39}$"
   }
  },
  "output_mode": {
   "enum": [
    "structured",
    "handoff",
    "text"
   ]
  },
  "output_schema": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[a-z0-9_./-]+\\.schema\\.json$"
  },
  "soul": {
   "enum": [
    "full",
    "values",
    "values_boundaries",
    "none"
   ]
  },
  "prompt_mode": {
   "enum": [
    "by_class",
    "minimal"
   ]
  },
  "permissions": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "address_student",
    "delegate",
    "write_memory",
    "open_cards"
   ],
   "properties": {
    "address_student": {
     "type": "boolean"
    },
    "delegate": {
     "const": false
    },
    "write_memory": {
     "enum": [
      "none",
      "notes_gated"
     ]
    },
    "open_cards": {
     "type": "boolean"
    }
   }
  },
  "limits": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "max_iterations",
    "max_tool_rounds",
    "max_output_tokens",
    "wall_clock_s"
   ],
   "properties": {
    "max_iterations": {
     "type": "integer",
     "minimum": 1,
     "maximum": 20
    },
    "max_tool_rounds": {
     "type": "integer",
     "minimum": 0,
     "maximum": 12
    },
    "max_output_tokens": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "low",
      "mid",
      "high",
      "cloud"
     ],
     "properties": {
      "low": {
       "type": "integer",
       "minimum": 16
      },
      "mid": {
       "type": "integer",
       "minimum": 16
      },
      "high": {
       "type": "integer",
       "minimum": 16
      },
      "cloud": {
       "type": "integer",
       "minimum": 16
      }
     }
    },
    "wall_clock_s": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "first_token_s": {
     "type": "number",
     "exclusiveMinimum": 0
    }
   }
  },
  "background": {
   "type": "boolean",
   "default": false
  },
  "owner": {
   "type": "string",
   "minLength": 1
  },
  "last_reviewed_by": {
   "type": "string",
   "minLength": 1
  },
  "last_reviewed_at": {
   "type": "string",
   "format": "date"
  },
  "status": {
   "enum": [
