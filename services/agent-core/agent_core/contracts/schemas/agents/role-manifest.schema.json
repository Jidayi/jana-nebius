    "reviewed",
    "retired"
   ]
  },
  "stage": {
   "enum": [
    "S1",
    "S2",
    "S3",
    "S4",
    "S5"
   ]
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "audience": {
      "const": "student"
     }
    }
   },
   "then": {
    "properties": {
     "toolsets": {
      "not": {
       "contains": {
        "enum": [
         "compute",
         "ui"
        ]
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "audience": {
      "const": "team"
     }
    }
   },
   "then": {
    "properties": {
     "permissions": {
      "properties": {
       "address_student": {
        "const": false
       },
       "open_cards": {
        "const": false
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "output_mode": {
      "const": "structured"
     }
    }
   },
   "then": {
    "properties": {
     "output_schema": {
      "type": "string"
     }
    }
   }
  }
 ]
}
