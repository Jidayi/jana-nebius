# Deliberately incomplete Nebius template. Copy outside checkout and replace REQUIRED values.
# Provider routes and model prices inherit cloud_gateway/defaults.toml; requalify them before deployment.
# Never store credential values here. No deployment or inference spending is authorized by this file.
environment = "production"
audience_host = "REQUIRED-production-host"
storage_dir = "/var/lib/jana-cloud-gateway"
secrets_dir = "/run/credentials/jana-cloud-gateway.service"
study_model = "primary/strong-model"
study_vision_model = "primary/vision-model"
voice_enabled = false
open_registration = false
# Replace with measured worker costs before production billing.
study_extract_page_usd = 0.0
study_extract_minute_usd = 0.0

[entitlement_keys]
# REQUIRED: public licence-intermediate key IDs and base64 raw public keys.

[quotas]
# Fail closed until the operator supplies approved limits and an expiry.
deployment_daily_spend_usd = 0.0
deployment_total_spend_usd = 0.0
study_daily_spend_usd = 0.0
# REQUIRED: deployment_budget_expires_at = "actual-approved-UTC-expiry"
