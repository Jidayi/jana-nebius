{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://jana.dev/contracts/agents/aux-rule-match",
 "title": "Auxiliary output: rule matcher",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "applies"
 ],
 "properties": {
  "applies": {
   "type": "array",
   "maxItems": 16,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "rule_ref",
     "reason"
    ],
    "properties": {
     "rule_ref": {
      "type": "integer",
      "minimum": 1
     },
     "reason": {
      "type": "string",
      "maxLength": 160
     }
    }
   }
  }
 }
}
