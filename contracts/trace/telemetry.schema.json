      "phys_optics",
      "phys_projectile",
      "progress_update",
      "python_run",
      "session_recall",
      "show_hint",
      "show_visual",
      "skill",
      "stats_compute",
      "stats_distribution",
      "units_check_dimensions",
      "units_convert",
      "update_board"
     ]
    },
    "error_code": {
     "enum": [
      "invalid_args",
      "timeout",
      "unavailable",
      "unknown",
      "verification_failed",
      "other"
     ]
    },
    "process": {
     "enum": [
      "shell",
      "core",
      "worker",
      "runtime",
      "perception"
     ]
    },
    "connectivity": {
     "enum": [
      "off",
      "offline",
      "limited",
      "metered",
      "online",
      "unknown"
     ]
    },
    "feature": {
     "enum": [
      "cloud_tier",
      "downloads",
      "update_checks",
      "cloud_backup",
      "multi_device",
      "parent_remote_view",
      "cloud_voice",
      "study_materials",
      "telemetry",
      "crash_reports"
     ]
    },
    "repair_step": {
     "enum": [
      "unique_id",
      "name_repair",
      "json_repair",
      "type_coercion",
      "normalize",
      "salvaged_from_text"
     ]
    },
    "gate": {
     "enum": [
      "no_answer_leak",
      "verification",
      "budget",
      "safety",
      "schema",
      "other"
     ]
    }
   }
  }
 },
 "required": [
  "report_id",
  "app_version",
  "channel",
  "hardware_class",
  "os_family",
  "router_tier",
  "days",
  "metrics"
 ],
 "$defs": {
  "histogram": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "count": {
     "type": "integer",
     "minimum": 0
    },
    "sum": {
     "type": "number",
     "minimum": 0
    },
    "buckets": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 0
     },
     "minItems": 8,
     "maxItems": 8
    }
   },
   "required": [
    "count",
    "sum",
    "buckets"
   ]
  },
  "metrics": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "core_ready_ms": {
     "$ref": "#/$defs/histogram"
    },
    "ready_ms": {
     "$ref": "#/$defs/histogram"
    },
    "model_load_ms": {
     "$ref": "#/$defs/histogram"
    },
    "ttft_ms": {
     "$ref": "#/$defs/histogram"
    },
    "prompt_tokens_per_s": {
