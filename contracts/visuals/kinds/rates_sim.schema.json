{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://jana.dev/contracts/visuals/kinds/rates_sim",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "temperature_k": {
   "type": "number",
   "minimum": 1,
   "maximum": 3000
  },
  "concentration_mol_l": {
   "type": "number",
   "minimum": 0
  },
  "activation_energy_j_mol": {
   "type": "number",
   "minimum": 0
  },
  "pre_exponential_s": {
   "type": "number",
   "minimum": 1e-09
  },
  "catalysed_activation_energy_j_mol": {
   "type": "number",
   "minimum": 0
  },
  "locked": {
   "type": "array",
   "items": {
    "enum": [
     "temperature",
     "concentration",
     "catalyst"
    ]
   },
   "maxItems": 3,
   "uniqueItems": true
  },
  "predict": {
   "enum": [
    "poe.chm.rates_hotter_same_amount.v1"
   ]
  }
 },
 "required": [
  "temperature_k",
  "concentration_mol_l",
  "activation_energy_j_mol",
  "pre_exponential_s",
  "catalysed_activation_energy_j_mol"
 ]
}
