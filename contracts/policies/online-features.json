    ],
    "data_classes": [
      "diagnostics"
    ],
    "queued": "outbox",
    "consent": "device",
    "authenticated": false,
    "dpia_gate": "pilot_start",
    "destination_label": "Usage reports"
  },
  "crash_reports": {
    "stage": "S2",
    "service": "crash",
    "payload_classes": [
      "crash_report",
      "consent_withdrawal"
    ],
    "data_classes": [
      "diagnostics"
    ],
    "queued": "outbox",
    "consent": "device",
    "authenticated": false,
    "dpia_gate": "pilot_start",
    "destination_label": "Crash reports"
  }
