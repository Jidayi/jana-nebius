{
  "cloud_tier": {
    "stage": "S2",
    "service": "gateway",
    "payload_classes": [
      "cloud_prompt",
      "service_auth",
      "consent_withdrawal"
    ],
    "data_classes": [
      "question_text",
      "board",
      "image",
      "learner_summary"
    ],
    "queued": "never",
    "consent": "profile",
    "authenticated": true,
    "dpia_gate": "cloud_tier",
    "destination_label": "Cloud tutor"
  },
  "downloads": {
    "stage": "S2",
    "service": "downloads",
    "payload_classes": [
      "download_request",
      "licence_activation"
    ],
    "data_classes": [],
    "queued": "resume",
    "consent": "none",
    "authenticated": false,
    "dpia_gate": "pilot_start",
    "destination_label": "Downloads"
  },
  "update_checks": {
    "stage": "S2",
    "service": "updates",
    "payload_classes": [
      "update_check"
    ],
    "data_classes": [],
    "queued": "next_check",
    "consent": "none",
    "authenticated": false,
    "dpia_gate": "pilot_start",
    "destination_label": "Update check"
  },
  "cloud_backup": {
    "stage": "S4",
    "service": "backup",
    "payload_classes": [
      "backup_snapshot",
      "tombstone",
      "consent_withdrawal",
      "service_auth"
    ],
    "data_classes": [
      "learner_summary",
      "progress_report"
    ],
    "queued": "latest_only",
    "consent": "profile",
    "authenticated": true,
    "dpia_gate": "s4_launch",
    "destination_label": "Backup"
  },
  "multi_device": {
    "stage": "S4",
    "service": "relay",
    "payload_classes": [
      "multi_device_segment",
      "tombstone",
      "consent_withdrawal",
      "service_auth"
    ],
    "data_classes": [
      "progress_report"
    ],
    "queued": "outbox",
    "consent": "profile",
    "authenticated": true,
    "dpia_gate": "s4_launch",
    "destination_label": "Your other devices"
  },
  "parent_remote_view": {
    "stage": "S4",
    "service": "parent_view",
    "payload_classes": [
      "parent_digest",
      "tombstone",
      "consent_withdrawal",
      "service_auth"
    ],
    "data_classes": [
      "progress_report"
    ],
    "queued": "latest_only",
    "consent": "profile",
    "authenticated": true,
    "dpia_gate": "s4_launch",
    "destination_label": "Parent view"
  },
  "cloud_voice": {
    "stage": "S4",
    "service": "voice",
    "payload_classes": [
      "voice_stream",
      "service_auth",
      "consent_withdrawal"
    ],
    "data_classes": [
      "audio",
      "transcript"
    ],
    "queued": "never",
    "consent": "profile",
    "authenticated": true,
    "dpia_gate": "s4_voice",
    "destination_label": "Cloud voice"
  },
  "study_materials": {
    "stage": "S3",
    "service": "gateway",
    "payload_classes": [
      "study_material",
      "tombstone",
      "consent_withdrawal",
      "service_auth"
    ],
    "data_classes": [
      "document",
      "image",
      "audio",
      "transcript"
    ],
    "queued": "outbox",
    "consent": "profile",
    "authenticated": true,
    "dpia_gate": "s3_launch",
    "destination_label": "Online study service"
  },
  "telemetry": {
    "stage": "S2",
    "service": "telemetry",
    "payload_classes": [
