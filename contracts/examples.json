    "contract": "learning/rule",
    "label": "rules_example",
    "value": {
      "schema_version": "1.0",
      "pack": "core-pedagogy",
      "rules": [
        {
          "id": "wrong_step_ask_intent",
          "version": "1.0",
          "status": "active",
          "condition": {
            "predicate": {
              "all": [
                {
                  "signal": "step.verdict",
                  "op": "eq",
                  "value": "incorrect"
                },
                {
                  "signal": "step.misconception_matched",
                  "op": "eq",
                  "value": false
                }
              ]
            }
          },
          "action": "Before correcting, ask what the student was trying to do in that line. Do not show the fix yet.",
          "priority_class": "pedagogy",
          "priority": 50,
          "scope": {
            "modes": [
              "guided",
              "practice",
              "check_working"
            ]
          },
          "relationships": [],
          "criticality": "normal",
          "frequency": {
            "once_per_step": true
          },
          "evidence": [
            "E6"
          ],
          "tests": [
            "scn_wrong_step_ask_intent"
          ],
          "owner": "Learning designer"
        },
        {
          "id": "misconception_name_gently",
          "version": "1.0",
          "status": "active",
          "condition": {
            "predicate": {
              "signal": "step.misconception_matched",
              "op": "eq",
              "value": true
            }
          },
          "action": "Name the matched misconception in plain words without blame, then ask the skill's targeted fix question.",
          "priority_class": "pedagogy",
          "priority": 60,
          "scope": {
            "modes": [
              "guided",
              "practice",
              "check_working",
              "revision"
            ]
          },
          "relationships": [
            {
              "type": "overrides",
              "target": "wrong_step_ask_intent"
            },
            {
              "type": "entails",
              "target": "revisit_misconception_check"
            }
          ],
          "criticality": "normal",
