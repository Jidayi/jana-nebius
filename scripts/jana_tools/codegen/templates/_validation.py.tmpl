"""Validate instances against the canonical contract schemas (JSON Schema 2020-12).

The generated Pydantic models cannot express every rule a schema states (conditionals, unevaluated properties,
cross-field constraints), so every boundary validates against the schema itself first. Schemas are bundled with
this package and resolved from an in-memory registry: nothing is fetched (D4, D45).

    validate("api/events", data)                      # a contract's root
    validate("api/commands#/$defs/StartTurn", body)   # one definition of a catalogue
"""

from __future__ import annotations

import json
import re
from datetime import date
from functools import cache
from pathlib import Path
from typing import Any

from jsonschema import Draft202012Validator, FormatChecker
from referencing import Registry, Resource
from referencing.jsonschema import DRAFT202012

NAMESPACE = "https://jana.dev/contracts/"
SCHEMAS = Path(__file__).parent / "schemas"


class ContractViolationError(ValueError):
    """An instance does not satisfy its contract."""

    def __init__(self, schema: str, errors: list[str]) -> None:
        super().__init__(f"{schema}: " + "; ".join(errors))
        self.schema = schema
        self.errors = errors


@cache
def _documents() -> dict[str, dict[str, Any]]:
    documents = {}
    for path in sorted(SCHEMAS.rglob("*.schema.json")):
        schema = json.loads(path.read_text())
        documents[schema["$id"]] = schema
    return documents


@cache
def _registry() -> Registry:
    resources = [(i, Resource.from_contents(s, default_specification=DRAFT202012)) for i, s in _documents().items()]
    return Registry().with_resources(resources)


# Formats used by the contracts, with the same semantics as the TypeScript validators (ajv-formats, full mode).
_DATE = re.compile(r"^(\d{4})-(\d{2})-(\d{2})$")
_DATE_TIME = re.compile(r"^(\d{4}-\d{2}-\d{2})[Tt ](\d{2}):(\d{2}):(\d{2})(\.\d+)?([Zz]|[+-](\d{2}):(\d{2}))$")
# A URI with a scheme and no whitespace or control characters (no urllib: the tool worker may not import it).
_URI = re.compile(r"^[A-Za-z][A-Za-z0-9+.-]*:[^\s\x00-\x1f\x7f]*$")
_FORMATS = FormatChecker(formats=())


@_FORMATS.checks("date")
def _is_date(value: object) -> bool:
    if not isinstance(value, str):
        return True
    match = _DATE.match(value)
    if not match:
        return False
    try:
        date(int(match[1]), int(match[2]), int(match[3]))
    except ValueError:
        return False
    return True


@_FORMATS.checks("date-time")
def _is_date_time(value: object) -> bool:
    if not isinstance(value, str):
        return True
    match = _DATE_TIME.match(value)
    if not match or not _is_date(match[1]):
        return False
    hour, minute, second = int(match[2]), int(match[3]), int(match[4])
    offset_ok = match[7] is None or (int(match[7]) <= 23 and int(match[8]) <= 59)
    return hour <= 23 and minute <= 59 and second <= 60 and offset_ok


@_FORMATS.checks("uri")
def _is_uri(value: object) -> bool:
    if not isinstance(value, str):
        return True
    return bool(_URI.match(value))


def resolve(name: str) -> str:
    """'api/events', 'api/events#/$defs/x' or a full $id, as a canonical reference."""
    return name if name.startswith(NAMESPACE) else NAMESPACE + name


@cache
def validator(name: str) -> Draft202012Validator:
    ref = resolve(name)
    if ref.partition("#")[0] not in _documents():
        raise KeyError(f"unknown contract {name!r}")
    return Draft202012Validator({"$ref": ref}, registry=_registry(), format_checker=_FORMATS)


def errors(name: str, instance: Any) -> list[str]:
    """Every violation, as '<json path>: <message>', in a stable order."""
    found = validator(name).iter_errors(instance)
    return sorted(f"{e.json_path}: {e.message}" for e in found)


def validate(name: str, instance: Any) -> None:
    problems = errors(name, instance)
    if problems:
        raise ContractViolationError(name, problems)


def schema_ids() -> tuple[str, ...]:
    return tuple(sorted(_documents()))


def document(name: str) -> dict[str, Any]:
    """A contract schema by name or $id (a copy), for consumers that must resolve references themselves."""
    copied: dict[str, Any] = json.loads(json.dumps(_documents()[resolve(name).partition("#")[0]]))
    return copied
