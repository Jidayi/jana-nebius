"""Contract versions and compatibility between processes (ARC-29, API-35).

Within a major, changes are additive, so peers with the same major work together whatever their minors; a
different major gets the interface's mismatch action from TABLE ARC-29a. The control channel additionally requires
the shell to meet the core's minimum minor. The tolerant event reader lets an older
client read a newer core's stream: unknown event types are skipped and unknown fields are dropped before strict
validation (working assumption, gaps.md G13).
"""

from __future__ import annotations

import copy
import json
import re
from dataclasses import dataclass
from functools import cache
from pathlib import Path
from typing import Any

from {{PACKAGE}}._validation import errors

DATA = Path(__file__).parent / "compat.json"


@dataclass(frozen=True, order=True)
class Version:
    major: int
    minor: int

    def __str__(self) -> str:
        return f"{self.major}.{self.minor}"


def parse(value: Any) -> Version:
    """'1.3', '1.3.0' (SemVer), {'major': 1, 'minor': 3}, or an integer major (1 -> 1.0)."""
    if isinstance(value, Version):
        return value
    if isinstance(value, bool):
        raise ValueError(f"not a version: {value!r}")
    if isinstance(value, int):
        return Version(value, 0)
    if isinstance(value, dict):
        return Version(int(value["major"]), int(value.get("minor", 0)))
    match = re.fullmatch(r"(\d+)\.(\d+)(?:\.\d+)?", str(value))
    if not match:
        raise ValueError(f"not a version: {value!r}")
    return Version(int(match[1]), int(match[2]))


@dataclass(frozen=True)
class Decision:
    ok: bool
    action: str | None  # the mismatch action of TABLE ARC-29a when not ok
    reason: str


@cache
def _data() -> dict[str, Any]:
    data: dict[str, Any] = json.loads(DATA.read_text())
    return data


def interfaces() -> dict[str, dict[str, str]]:
    table: dict[str, dict[str, str]] = _data()["interfaces"]
    return table


def current(interface: str) -> Version:
    return parse(interfaces()[interface]["version"])


def negotiate(interface: str, peer: Any, ours: Any = None) -> Decision:
    """Whether this side, at `ours` (default: the current version), works with a peer at `peer`."""
    spec = interfaces()[interface]
    mine, theirs = parse(ours) if ours is not None else current(interface), parse(peer)
    if mine.major != theirs.major:
        return Decision(False, spec["on_mismatch"], f"{interface}: major {theirs.major} != {mine.major}")
    if interface == "control" and theirs.minor < mine.minor:
        return Decision(False, spec["on_mismatch"], f"control: shell {theirs} is below core minimum {mine}")
    return Decision(True, None, f"{interface}: {theirs} works with {mine} (same major; minors are additive)")


def negotiate_api(meta_protocol: dict[str, int], client: Any) -> Decision:
    """A client at `client` against a core advertising Meta.protocol {major, min_minor, max_minor} (API-35)."""
    version = parse(client)
    if version.major != meta_protocol["major"] or not (
        meta_protocol["min_minor"] <= version.minor <= meta_protocol["max_minor"]
    ):
        return Decision(False, interfaces()["api"]["on_mismatch"], f"client {version} outside {meta_protocol}")
    return Decision(True, None, f"client {version} within {meta_protocol}")


def read_event(envelope: dict[str, Any], newer_minor: bool) -> tuple[str, dict[str, Any] | None, list[str]]:
    """Read one stream envelope. With `newer_minor` (the core advertises a higher minor than this client), unknown
    envelope fields and event fields are dropped and unknown event types are skipped. Returns
    ("accept" | "skip" | "reject", the envelope to use, the validation errors)."""
    candidate = copy.deepcopy(envelope)
    if newer_minor:
        known = _data()["events"]
        for key in [k for k in candidate if k not in known["envelope"]]:
            del candidate[key]
        event = candidate.get("event")
        if isinstance(event, dict):
            fields = known["types"].get(event.get("type"))
            if fields is None:
                return "skip", None, [f"unknown event type {event.get('type')!r} from a newer core"]
            for key in [k for k in event if k not in fields]:
                del event[key]
    problems = errors("api/events", candidate)
    return ("reject", None, problems) if problems else ("accept", candidate, [])
