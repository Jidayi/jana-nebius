#!/bin/sh
# Refuse to push commits that contain docs/ paths or specification text.
guard="$(git rev-parse --show-toplevel)/scripts/git-hooks/check-no-spec.sh"
zero=0000000000000000000000000000000000000000
status=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  "$guard" range "$range" || { echo "pre-push: refusing to push $local_ref." >&2; status=1; }
done
exit $status
