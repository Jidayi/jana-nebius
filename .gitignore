# The specification lives in its own private git repository checked out at docs/ (ARC-16).
# It must never be committed to this repository; spec.lock pins the commit we build against.
docs

# Dependencies, environments and build output
node_modules/
.venv/
target/
dist/
.turbo/
.pytest_cache/
.ruff_cache/
.mypy_cache/
coverage/
__pycache__/
*.pyc
.opensrc

# OS noise
.DS_Store

# Local agent and editor configuration
.claude/
# Persistent, owner-only development identity keys; never bundle or commit them.
/.local-state/

# Tauri build output (schemas regenerated by every build)
apps/desktop/src-tauri/gen/
# Bundle resources staged by the release job (scripts/packaging/build-sidecars.sh)
apps/desktop/src-tauri/resources/

# Evaluation run reports (EVL-23); release reports are published with the transparency record, not committed
evals/reports/

# Internal authoring build output; excluded from student bundles.
apps/studio/src-tauri/gen/
apps/studio/src-tauri/resources/

# Local secrets (SEC-20): a developer's .env never enters the repository. Provider keys belong in the OS keychain or
# the deployment's secret manager; a .env here is only for a developer's own dev key, loaded into the shell.
.env
.env.*
*.env
!.env.example
