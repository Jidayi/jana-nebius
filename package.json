{
  "name": "jana",
  "private": true,
  "description": "Jana monorepo: TypeScript workspaces driven by Turborepo.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "lint": "eslint . && depcruise packages apps/desktop/src && turbo run typecheck",
    "codegen": "turbo run codegen",
    "test": "turbo run test --continue",
    "build": "turbo run build",
    "gallery": "turbo run gallery",
    "eval:quick": "turbo run eval:quick",
    "bootstrap": "pnpm install --frozen-lockfile && uv sync --locked --all-packages && cargo build --locked --workspace && uv build --all-packages --out-dir dist/sidecars"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "colorjs.io": "0.7.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "json-schema-to-typescript": "16.0.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "turbo": "2.11.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
