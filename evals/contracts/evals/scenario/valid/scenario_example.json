        "s1"
      ],
      "synthetic": true,
      "setup": {
        "profile": {
          "level": "O",
          "subjects": [
            "physics"
          ],
          "age_band": "13_15"
        },
        "mode": "guided",
        "question": {
          "text": "A ball is thrown straight up at 14 m/s. Take g = 9.8 m/s^2. How high does it rise?"
        },
        "model": {
          "hardware_class": "mid",
          "network": "disabled"
        },
        "seed": 3,
        "repeats": 1
      },
      "turns": [
        {
          "note": "The Solver's hidden plan carries worker-checked values; the Coach does not volunteer the height.",
          "action": {
            "kind": "stuck"
          },
          "expect": [
            {
              "template": "tpl.entry_question"
            },
            {
              "no_answer_leak": true
            }
          ]
        },
        {
          "action": {
            "kind": "stuck"
          },
          "expect": [
            {
              "hint_rung": {
                "eq": 1
              }
            },
            {
              "no_answer_leak": true
            },
            {
              "gate": {
                "name": "no_answer_leak",
                "fired": true,
                "outcome": "regenerated"
              }
            },
            {
              "reply": {
                "ends_with_question": true,
                "max_words": 60
              }
            }
          ]
        },
        {
          "student": "s = 10 m",
          "expect": [
            {
              "board_step": {
                "owner": "student",
                "status": "correct",
                "requires_check_id": true
              }
            },
            {
              "reply": {
                "must_mention_any": [
                  "10"
                ]
              }
            }
          ]
        }
      ],
      "final": [
        {
          "tool_call": {
            "name": "math_solve",
            "role": "solver",
            "status": "ok"
          }
        },
        {
          "network_calls": {
            "eq": 0
          }
        }
      ]
    }
  ]
}
