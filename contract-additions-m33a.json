      ],
      "why": "A KC to watch (TCH-12): `learning` for over `parent_watch_learning_days` (proposal: 2 weeks) or `moved_on`, with which.",
      "value": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kc_id": {
            "type": "string",
            "maxLength": 96
          },
          "subject": {
            "enum": [
              "mathematics",
              "physics",
              "chemistry",
              "biology",
              "accounting"
            ]
          },
          "topic_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 96
              },
              {
                "type": "null"
              }
            ]
          },
          "topic_title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "statement": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "enum": [
              "learning_long",
