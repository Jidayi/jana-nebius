{
  "proposal": "Contract pieces TCH-12, TCH-14, UXS-33, UXS-46a and UXS-48 imply (D72 standing approval to add spec-implied pieces and report after), proposed by M33.a; they close G120's \"Local alerts have no route\". Each entry is a JSON Pointer into a contract under docs/specification/contracts (or an endpoint for TABLE API-27a) and the value to add there. Until the specification adopts them the core serves them as written here (agent_core/api/parents.py checks the dismiss body itself, and the core's tests check every reply against these definitions), and client-core's parent summary and history controllers check each reply against the same shapes before accepting it (src/parents.ts, src/history.ts). Once adopted, codegen picks them up and these local checks give way to the contract's.",
  "additions": [
    {
      "target": "api/commands.schema.json",
      "pointer": "/$defs/DigestKc",
      "requirements": [
        "TCH-12"
      ],
      "why": "A KC the digest names: its id, subject and the installed pack's own topic title and statement (authored content, never student text); the client words the line around them.",
      "value": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kc_id": {
            "type": "string",
            "maxLength": 96
          },
          "subject": {
            "enum": [
              "mathematics",
              "physics",
              "chemistry",
              "biology",
              "accounting"
            ]
          },
          "topic_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 96
              },
              {
                "type": "null"
              }
            ]
          },
          "topic_title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "statement": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kc_id",
          "subject",
          "topic_id",
          "topic_title",
          "statement"
        ]
      }
    },
    {
